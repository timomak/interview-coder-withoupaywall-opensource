        },
        "approvedPacketSha": {
          "const": "02ee6ddec78d6e4ea9e2de3c0303ffd6bc9f45bf"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
