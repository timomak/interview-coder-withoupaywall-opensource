{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timofey.dev/schemas/interviewcopilot-capability-request-v1.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
