          "const": "02ee6ddec78d6e4ea9e2de3c0303ffd6bc9f45bf"
        },
        "prNumber": {
          "type": "integer",
          "minimum": 1
        },
        "expectedHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    {
