{
  "name": "interview-copilot",
  "version": "1.0.19",
  "main": "./dist-electron/main.js",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "node scripts/verification/clean-outputs.mjs",
    "dev": "cross-env NODE_ENV=development npm run clean && concurrently \"tsc -w -p tsconfig.electron.json\" \"vite\" \"wait-on -t 30000 http://localhost:54321 && electron ./dist-electron/main.js\"",
    "test": "node scripts/verification/trusted-vitest-runner.mjs all",
    "test:legacy": "node scripts/verification/trusted-vitest-runner.mjs legacy",
    "test:unit": "node scripts/verification/trusted-vitest-runner.mjs unit",
    "test:p01": "node scripts/verification/trusted-vitest-runner.mjs p01",
    "test:p02": "node scripts/verification/trusted-vitest-runner.mjs p02",
    "test:p03": "node scripts/verification/trusted-vitest-runner.mjs p03",
    "test:p04": "node scripts/verification/trusted-vitest-runner.mjs p04",
    "test:p05": "node scripts/verification/trusted-vitest-runner.mjs p05",
    "test:p06": "node scripts/verification/trusted-vitest-runner.mjs p06",
    "test:coding-fixtures": "node scripts/verification/trusted-vitest-runner.mjs coding-fixtures",
    "test:p07": "node scripts/verification/trusted-vitest-runner.mjs p07",
    "test:system-design-fixtures": "node scripts/verification/trusted-vitest-runner.mjs system-design-fixtures",
    "test:p08": "node scripts/verification/trusted-vitest-runner.mjs p08",
    "test:behavioral-fixtures": "node scripts/verification/trusted-vitest-runner.mjs behavioral-fixtures",
    "test:p09": "node scripts/verification/trusted-vitest-runner.mjs p09",
    "test:audio-native": "node scripts/verification/trusted-vitest-runner.mjs audio-native",
    "test:audio-engine": "npm run prepare:audio && node scripts/audio/verify-packaged-local-transcription.mjs",
    "test:audio-retention": "node scripts/verification/trusted-vitest-runner.mjs audio-retention",
    "test:electron-shell": "node scripts/verification/trusted-vitest-runner.mjs electron-shell && node scripts/verification/run-electron-shell-runtime.mjs",
    "prepare:audio": "node scripts/audio/prepare-packaged-audio.mjs",
    "lint": "node scripts/verification/source-inventory.mjs && eslint .",
    "typecheck": "node scripts/verification/typecheck-inventory.mjs && tsc -p tsconfig.electron.json --noEmit",
    "verify:node": "node scripts/verification/require-node20.mjs",
    "verify:policy": "node scripts/verification/product-policy.mjs",
    "verify:test-manifest": "node scripts/verification/test-manifest.mjs",
    "start": "cross-env NODE_ENV=development concurrently \"tsc -p tsconfig.electron.json\" \"vite\" \"wait-on -t 30000 http://localhost:54321 && electron ./dist-electron/main.js\"",
    "build": "npm run prepare:audio && npm run build:runtime && npm run verify:package-inventory",
    "build:runtime": "cross-env NODE_ENV=production npm run clean && vite build && tsc -p tsconfig.electron.json",
    "verify:package-inventory": "node scripts/verification/build-package-inventory.mjs",
    "run-prod": "cross-env NODE_ENV=production electron ./dist-electron/main.js",
    "package": "npm run build && electron-builder build",
    "package-mac": "npm run build && electron-builder build --mac",
    "package-win": "npm run build && electron-builder build --win"
  },
  "build": {
    "appId": "com.interviewcopilot.desktop",
    "productName": "InterviewCopilot",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.{test,spec}.{js,mjs,cjs,jsx,ts,mts,cts,tsx}",
      "!**/*.{jsx,ts,mts,cts,tsx}",
      "!**/*.map",
      "!scripts/verification/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "resources/audio",
        "to": "audio",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".artifacts/audio/models",
        "to": "audio/models",
        "filter": [
          "ggml-base.en.bin"
        ]
      }
    ],
    "compression": "maximum",
    "generateUpdatesFilesForAllChannels": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "InterviewCopilot records microphone audio only after you turn the microphone on for the active interview.",
        "NSSpeechRecognitionUsageDescription": "InterviewCopilot sends finalized audio to Apple Speech only after you explicitly enable remote transcription."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "InterviewCopilot-${arch}.${ext}",
      "icon": "assets/icons/mac/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Developer ID Application",
      "notarize": true,
      "protocols": {
        "name": "interview-coder-protocol",
        "schemes": [
          "interview-coder"
        ]
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/win/icon.ico",
      "artifactName": "${productName}-Windows-${version}.${ext}",
      "protocols": {
        "name": "interview-coder-protocol",
        "schemes": [
          "interview-coder"
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/png/icon-256x256.png",
      "artifactName": "${productName}-Linux-${version}.${ext}",
      "protocols": {
        "name": "interview-coder-protocol",
        "schemes": [
          "interview-coder"
        ]
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ibttf",
        "repo": "interview-coder",
        "private": false,
        "releaseType": "release"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    }
  },
  "keywords": [
    "interview",
    "coding",
    "interview prep",
    "technical interview",
    "tool"
  ],
  "author": "InterviewCopilot Contributors",
  "license": "AGPL-3.0-or-later",
  "description": "An open-source desktop copilot for technical interview practice.",
  "dependencies": {
    "@electron/notarize": "^2.3.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.64.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.1",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^2.5.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/typescript-definitions": "^8.14.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^0.11.0",
    "@eslint/markdown": "^6.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/color": "^4.2.0",
    "@types/diff": "^6.0.0",
    "@types/electron-store": "^1.3.1",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@typescript-eslint/utils": "^8.29.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.24.0",
    "eslint-flat-config-utils": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwind-csstree": "^0.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "vite": "^6.2.5",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0",
    "web-vitals": "2.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
